# AutoPredict configuration. Copy to `.env` (never commit `.env`).
# Every variable maps to a field in backend/core/settings.py.

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database / cache ─────────────────────────────────────────────────────────
# Local default (no setup): SQLite file in backend/. Docker Compose uses PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://autopredict:autopredict@localhost:5432/autopredict
DATABASE_URL=
REDIS_URL=                    # e.g. redis://localhost:6379/0 (optional; enables multi-process WebSocket fan-out)

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ── Demo data (python -m sim.build) ──────────────────────────────────────────
DEMO_STAFF_PASSWORD=          # 10+ characters; used for the demo staff logins

# ── AI runtime ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
ENABLE_BACKGROUND_DIAGNOSIS=true
DIAGNOSIS_INTERVAL_MINUTES=30

# ── Business configuration ───────────────────────────────────────────────────
PLATFORM_MONTHLY_COST_INR=50000

# ── Channels (leave empty to keep a channel in simulation mode) ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=
WEBHOOK_BASE_URL=
EMAIL_WEBHOOK_SECRET=          # sent by your email parse service as X-Webhook-Secret
